config {
    id "urn:com.arcadiaeditions:fulfillment:shipping"
    version "0.1.0"
    title "Arcadia Editions - Fulfillment Shipping"
    basePackage "com.arcadiaeditions.fulfillment.shipping"
    persistence jpa

    plugins {
        /** Generates an AsyncAPI v3 specification from this ZDL model. */
        ZDLToAsyncAPIPlugin {
            id "urn:com.arcadiaeditions:fulfillment:shipping:asyncapi"
            applicationExtensions """
            x-application-bindings:
              x-principal: fulfillment_shipping
              x-clientId: fulfillment_shipping
              x-groupId: fulfillment_shipping
            """
            schemaFormat avro
            idType integer
            idTypeFormat int64
            avroPackage com.arcadiaeditions.fulfillment.shipping.events.avro
            includeCloudEventsHeaders true
            includeKafkaCommonHeaders true
            asyncapiOverlayFiles "https://raw.githubusercontent.com/arcadia-editions/api-contract-commons/refs/heads/main/asyncapi-overlay.yml"
            targetFile "./asyncapi.yml"
        }
        ZDLToAsyncAPIClientPlugin {
            id "urn:com.arcadiaeditions:fulfillment:shipping:asyncapi:client"
            applicationExtensions """
            x-application-bindings:
              x-principal: fulfillment_shipping
              x-clientId: fulfillment_shipping
              x-groupId: fulfillment_shipping
            """
            title "Arcadia Editions - Fulfillment Shipping - AsyncAPI Client"
            asyncapiOverlayFiles "https://raw.githubusercontent.com/arcadia-editions/api-contract-commons/refs/heads/main/asyncapi-client-overlay.yml"
            targetFile "./asyncapi-client.yml"
        }
        /** Generates an OpenAPI 3.0 specification from this ZDL model. */
        ZDLToOpenAPIPlugin {
            idType integer
            idTypeFormat int64
            targetFile "./openapi.yml"
        }
    }
}

apis {
    asyncapi client OrdersCheckoutApi "https://raw.githubusercontent.com/arcadia-editions/orders-checkout-api/main/asyncapi.yml"
    asyncapi client PaymentsProcessingApi "https://raw.githubusercontent.com/arcadia-editions/payments-processing-api/main/asyncapi.yml"
}

@aggregate
@lifecycle(field: status, initial: SCHEDULED)
entity Fulfillment {
    fulfillmentId String required unique
    orderId String required unique
    customerId String required
    status FulfillmentStatus required
    @json shippingAddress ShippingAddress required {
        name String required
        line1 String required
        line2 String
        city String required
        region String
        postalCode String required
        country String required
    }
    @json items FulfillmentItem[] required minlength(1) {
        sku String required
        quantity Integer required
    }
    carrierCode String
    trackingNumber String
    scheduledAt Instant
    readyAt Instant
    failedAt Instant
    failureReason String
    /** Set from PaymentCaptured; markReadyToShip requires it. */
    paymentCapturedAt Instant
    cancelledAt Instant
    cancellationReason String
}

enum FulfillmentStatus {
    SCHEDULED
    READY_TO_SHIP
    FAILED
    CANCELLED
}

input ScheduleFulfillmentInput {
    orderId String required
    customerId String required
    shippingAddress ShippingAddressInput required
    items FulfillmentItemInput[] required
}

input RecordPaymentCapturedInput {
    orderId String required
    /** PaymentCaptured.capturedAt */
    capturedAt Instant required
}

input CancelFulfillmentInput {
    orderId String required
    /** OrderCancelled.reason */
    reason String required
}

input ShippingAddressInput {
    name String required
    line1 String required
    line2 String
    city String required
    region String
    postalCode String required
    country String required
}

input FulfillmentItemInput {
    sku String required
    quantity Integer required
}

@rest("/fulfillments")
service FulfillmentShippingService for (Fulfillment) {

    /** No-op, no event, when a Fulfillment exists for orderId (redelivery). */
    @asyncapi(api: OrdersCheckoutApi, channel: "order-confirmed-event-v1")
    @transition(to: [SCHEDULED, FAILED])
    scheduleFulfillment(ScheduleFulfillmentInput) Fulfillment withEvents [FulfillmentScheduled | FulfillmentFailed]

    /**
     * Money moved: the warehouse may now prepare the parcel. Sets paymentCapturedAt; no state change,
     * no event. No-op when there is no Fulfillment, it is not SCHEDULED, or paymentCapturedAt is set.
     */
    @asyncapi(api: PaymentsProcessingApi, channel: "payment-captured-event-v1")
    recordPaymentCaptured(RecordPaymentCapturedInput) Fulfillment?

    /** Warehouse action. Refused (no transition, no event) until paymentCapturedAt is set. */
    @transition(from: SCHEDULED, to: READY_TO_SHIP)
    markReadyToShip(id) Fulfillment withEvents FulfillmentReadyToShip

    /** No-op, no event, when there is no Fulfillment for orderId or it is FAILED or CANCELLED. */
    @asyncapi(api: OrdersCheckoutApi, channel: "order-cancelled-event-v1")
    @transition(from: [SCHEDULED, READY_TO_SHIP], to: CANCELLED)
    cancelFulfillment(CancelFulfillmentInput) Fulfillment? withEvents FulfillmentCancelled
}

@asyncapi({ channel: "fulfillment-scheduled-event-v1", topic: "fulfillment-shipping.fulfillment-scheduled.event.avro.v1" })
event FulfillmentScheduled {
    fulfillmentId String
    orderId String
    customerId String
    scheduledAt Instant
}

@asyncapi({ channel: "fulfillment-failed-event-v1", topic: "fulfillment-shipping.fulfillment-failed.event.avro.v1" })
event FulfillmentFailed {
    fulfillmentId String
    orderId String
    customerId String
    reason String
    failedAt Instant
}

@asyncapi({ channel: "fulfillment-ready-to-ship-event-v1", topic: "fulfillment-shipping.fulfillment-ready-to-ship.event.avro.v1" })
event FulfillmentReadyToShip {
    fulfillmentId String
    orderId String
    customerId String
    carrierCode String
    trackingNumber String
    readyAt Instant
}

/** Published for the warehouse; no step of place-order-flow consumes it. */
@asyncapi({ channel: "fulfillment-cancelled-event-v1", topic: "fulfillment-shipping.fulfillment-cancelled.event.avro.v1" })
event FulfillmentCancelled {
    fulfillmentId String
    orderId String
    customerId String
    reason String
    cancelledAt Instant
}
